---
// Selected: the curated set from photos/selected.yml, in that order.
import Gallery from '../../components/photo/Gallery.astro';
import { loadPhotos } from '../../lib/photos/load';
import { withBase } from '../../lib/url';
import { SITE } from '../../data/site';

const { years, selected } = await loadPhotos();
---

<Gallery
  years={years}
  photos={selected}
  active={{ kind: 'selected' }}
  heading="Selected photographs"
  title={`Photography — ${SITE.name}`}
  description={`Selected photographs by ${SITE.name}.`}
  listUrl={withBase('/photography/')}
/>
