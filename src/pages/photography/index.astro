---
// Featured: the curated set from photos/selected.yml, in that order.
import Gallery from '../../components/photo/Gallery.astro';
import { loadPhotos } from '../../lib/photos/load';
import { withBase } from '../../lib/url';
import { SITE } from '../../data/site';

const { categories, selected } = await loadPhotos();
---

<Gallery
  categories={categories}
  sections={[{ photos: selected }]}
  active={{ kind: 'selected' }}
  heading="Featured photographs"
  title={`Photography — ${SITE.name}`}
  description={`Featured photographs by ${SITE.name}.`}
  listUrl={withBase('/photography/')}
/>
