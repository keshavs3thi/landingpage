---
// Workshop: mini projects, each a row of text beside a hero image that opens its page.
// Content lives in workshop/<folder>/index.md; SITE.showWorkshop decides whether the page is public.
import Base from '../../layouts/Base.astro';
import WorkshopHero from '../../components/WorkshopHero.astro';
import '../../styles/workshop.css';
import { SITE } from '../../data/site';
import { withBase } from '../../lib/url';
import { getWorkshop } from '../../lib/workshop';

const items = await getWorkshop();
---

<Base
  title={`Workshop — ${SITE.name}`}
  description={`Smaller projects and experiments by ${SITE.name}.`}
  noindex={!SITE.showWorkshop}
>
  <main class="workshop">
    <h1 class="visually-hidden">Workshop</h1>

    <ol class="workshop-list">
      {
        items.map((it, i) => (
          <li class:list={['ws-row', { 'is-link': it.url }]}>
            <div class="ws-text">
              <h2>{it.url ? <a href={withBase(it.url)}>{it.title}</a> : it.title}</h2>
              <p class="ws-tagline">{it.tagline}</p>
              <p class="ws-meta">
                {it.year}, {it.context}
              </p>
              <p class="ws-summary">{it.summary}</p>
            </div>
            <div class="ws-media">
              <WorkshopHero
                it={it}
                widths={[640, 960, 1400]}
                sizes="(max-width: 767px) calc(100vw - 40px), 40vw"
                eager={i < 2}
                priority={i === 0}
              />
            </div>
          </li>
        ))
      }
    </ol>
  </main>
</Base>
