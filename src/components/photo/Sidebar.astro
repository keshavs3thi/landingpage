---
// Back, Selected, then People / Places / Things with their projects (links to sections on the
// category page). Generated from photos/. The current category is expanded; others collapse
// behind a toggle (photo-nav.ts).
import { withBase } from '../../lib/url';
import type { Category } from '../../lib/photos/types';

export type Active = { kind: 'selected' } | { kind: 'category'; category: string };

interface Props {
  categories: Category[];
  active: Active;
  idPrefix: string; // keeps toggle ids unique if the sidebar renders more than once
}

const { categories, active, idPrefix } = Astro.props;
const current = (cond: boolean) => (cond ? 'page' : undefined);
const activeCategory = active.kind === 'category' ? active.category : undefined;
---

<nav class="side-nav" aria-label="Photography">
  <a class="side-back" href={withBase('/')}>Back</a>
  <ul class="side-list">
    <li>
      <a href={withBase('/photography/')} aria-current={current(active.kind === 'selected')}>Selected</a>
    </li>
    {
      categories.map((c) => {
        const open = c.slug === activeCategory;
        const id = `${idPrefix}-c-${c.slug}`;
        return (
          <li class="side-year">
            <div class="side-row">
              <a href={withBase(c.url)} aria-current={current(open)} class:list={[{ 'is-open': open }]}>
                {c.title}
              </a>
              {/* A category without projects has nothing to expand. */}
              {c.projects.length > 0 && (
                <button
                  class="side-toggle"
                  type="button"
                  aria-expanded={open ? 'true' : 'false'}
                  aria-controls={id}
                  data-toggle
                >
                  <span class="visually-hidden">Show {c.title} projects</span>
                  <span aria-hidden="true">{open ? '−' : '+'}</span>
                </button>
              )}
            </div>
            {c.projects.length > 0 && (
              <ul class="side-projects" id={id} hidden={!open}>
                {c.projects.map((p) => (
                  <li>
                    <a href={withBase(p.url)}>{p.title}</a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        );
      })
    }
  </ul>
</nav>
