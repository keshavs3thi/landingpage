---
import { SITE } from '../data/site';
import { hasResumePdf } from '../lib/resume';
import { withBase } from '../lib/url';

// Resume links to /resume/ only once the PDF (the page's source) exists in public/.
const hasResume = hasResumePdf();
---

<header class="nav">
  <a class="wordmark" href={withBase('/')}>{SITE.name}</a>
  <nav aria-label="Primary">
    <ul>
      {
        SITE.showAbout && (
          <li>
            <a href={withBase('/about/')}>About</a>
          </li>
        )
      }
      <li>
        {
          hasResume ? (
            <a href={withBase('/resume/')}>Resume</a>
          ) : (
            <span class="muted" title="Coming soon">
              Resume<span class="visually-hidden"> (coming soon)</span>
            </span>
          )
        }
      </li>
      <li>
        <a href={`mailto:${SITE.email}`}>Contact</a>
      </li>
    </ul>
  </nav>
</header>
